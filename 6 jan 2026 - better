# ============================================================
# DATA IMPORT & BASIC CLEANING
# ============================================================

getwd()

read.csv("data_school.csv")
data <- read.csv("data_school.csv")
View(data)

data <- data %>% select(-Timestamp)
View(data)


# ============================================================
# CONSENT FILTER (Q1)
# ============================================================

"No" %in% data$Q1

sum(grepl("No", data$Q1, ignore.case = TRUE), na.rm = TRUE)

data <- data %>%
  filter(!grepl("^no$", Q1, ignore.case = TRUE))


# ============================================================
# SCHOOL CLEANING (Q5)
# ============================================================

table(data$Q5)

data <- data %>%
  mutate(
    Q5_clean = Q5 %>%
      str_trim() %>%
      str_to_upper(),
    Q5_clean = na_if(Q5_clean, "")
  )

table(data$Q5_clean)

data <- data %>% filter(Q5_clean != "SPDAV")
data <- data %>% filter(Q5_clean != "DPSS")

table(data$Q5_clean)


# ============================================================
# TOTAL COUNT CHECK
# ============================================================

data %>%
  count(Q5_clean) %>%
  summarise(total_n = sum(n))


