Q7_overall <- data %>%
  tab_cells(Q7) %>%
  tab_cols(total()) %>%
  tab_stat_cases(label = "Count") %>%
  tab_stat_cpct(label = "Percent") %>%
  tab_pivot()

Q7_overall

