# Removing time stamp
data <- data %>% select(-Timestamp)
View(data)


# Checking who all have said No to participate in the study 
"No" %in% data$Q1
sum(grepl("No", data$Q1, ignore.case = TRUE), na.rm = TRUE)


data <- data %>%
  filter(!grepl("^no$", Q1, ignore.case = TRUE))


# Rechecking

"No" %in% data$Q1
sum(grepl("No", data$Q1, ignore.case = TRUE), na.rm = TRUE)


# Q3: CLEANING SCHOOL 

table(data$Q5)

data <- data %>%
    mutate(
        Q5_clean = Q5 %>%
            str_trim() %>%
            str_to_upper(),
        Q5_clean = na_if(Q5_clean, "")
    )

table(data$Q5_clean)

# Removing SPDAV - as it was already coded as SRDAV
# Removing DPSS

data <- data %>%
  filter(Q5_clean != "SPDAV")

data <- data %>%
    filter(Q5_clean != "DPSS")

table(data$Q5_clean)

